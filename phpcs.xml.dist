<?xml version="1.0"?>
<ruleset name="RAN Ecwid Shop Teaser">
	<description>RAN WordPress plugin standards with repository-local support and exception policy.</description>
	<file>ran-ecwid-shop-teaser.php</file>
	<file>includes</file>
	<file>blocks</file>
	<file>tools</file>
	<file>tests</file>
	<arg name="extensions" value="php" />
	<!-- Build-tool asset metadata is checked by syntax and generated-file gates. -->
	<exclude-pattern>*/index.asset.php</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>

	<!-- Repository support policy remains local. -->
	<config name="minimum_wp_version" value="6.5" />
	<config name="testVersion" value="8.0-" />

	<!-- Shared RAN WordPress/WPCS/PHPCompatibility ancestry. -->
	<rule ref="RANWordPressPlugin" />

</ruleset>
